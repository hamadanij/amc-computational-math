'''Question:
A sequence of natural numbers is constructed by listing the first 4, 
then skipping one, listing the next 5, skipping 2, listing 6, 
skipping 3, and on the nth iteration, listing n + 3 and skipping n. 
The sequence begins 1, 2, 3, 4, 6, 7, 8, 9, 10, 13. 
What is the 500,000th number in the sequence?'''

total_listed = 0
current_number = 0
level = 1

while total_listed < 500000:
    list_count = level + 3
    skip_count = level

    if total_listed + list_count >= 500000:
        needed = 500000 - total_listed
        answer = current_number + needed
        print(answer)
        total_listed = 500000
    else:
        total_listed += list_count
        current_number += list_count + skip_count
        level += 1
